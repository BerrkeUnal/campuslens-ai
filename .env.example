APP_ENV=development
FRONTEND_ORIGIN=http://127.0.0.1:5500

DATABASE_URL=sqlite:///./data/campuslens.db

QDRANT_URL=./data/qdrant_local
QDRANT_COLLECTION=campuslens_chunks

EMBEDDING_MODEL=intfloat/multilingual-e5-small
SPARSE_MODEL=Qdrant/bm25
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# CPU is the portable default; cuda:0 requires CUDA-enabled PyTorch.
RERANKER_DEVICE=cpu

# Prepare local AI models during application startup.
MODEL_WARMUP_ENABLED=true

LLM_PROVIDER=ollama
LLM_TEMPERATURE=0

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_KEEP_ALIVE=30m

# Yalnızca LLM_PROVIDER=openai seçilirse gereklidir.
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini

CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60

DENSE_TOP_K=20
BM25_TOP_K=20
RERANK_TOP_K=5

MAX_UPLOAD_MB=20
